# Shell + same-origin gateway to the BFF (cookies stay first-party, SameSite=Strict).
upstream bff {
  server ${BFF_UPSTREAM};
  keepalive 16;
}

# Strict CSP (web.dev/strict-csp), mirroring tools/mf/csp.ts:
#  - Scripts need this response's nonce; 'strict-dynamic' extends trust to the scripts they
#    load (federated remotes, the Ext JS runtime). No host allow-list to maintain or bypass.
#  - The nonce is nginx's $request_id: 128 random bits, fresh for every response.
#  - 'unsafe-eval' is required by Ext JS (XTemplate, data readers use new Function()).
#  - 'unsafe-inline' styles: Emotion (MUI) and Ext JS write style tags/attributes.
#  - `https: 'unsafe-inline'` in script-src are ignored by CSP3 browsers (legacy fallback).
map $request_id $csp {
  default "default-src 'self'; script-src 'nonce-$request_id' 'strict-dynamic' 'unsafe-eval' https: 'unsafe-inline'; object-src 'none'; base-uri 'none'; style-src 'self' ${REMOTE_ORIGINS} 'unsafe-inline'; font-src 'self' ${REMOTE_ORIGINS} data:; img-src 'self' ${REMOTE_ORIGINS} data:; connect-src 'self' ${REMOTE_ORIGINS}; frame-ancestors 'none'; form-action 'self'";
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Container liveness probe (never proxied, never logged).
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  # `^~`: a plain prefix would lose to the regex location below and this block would be dead.
  location ^~ /api/stream {
    proxy_pass http://bff;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Server-Sent Events: never buffer, keep the connection open.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  # Proxied responses carry the BFF's own security headers (helmet); the nginx snippet is
  # for the static files it serves itself.
  location ~ ^/(api|auth)/ {
    proxy_pass http://bff;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /config/remotes.json {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }

  # Content-hashed assets: cache forever.
  location /static/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  # SPA: every route serves index.html with a fresh CSP nonce. It must never be
  # stored: a cached copy would carry a nonce that the next policy no longer allows.
  location / {
    try_files $uri /index.html;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy $csp always;
    add_header Cache-Control "no-store" always;
    etag off;
    sub_filter_once off;
    sub_filter '__CSP_NONCE__' $request_id;
  }
}
